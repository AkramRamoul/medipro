{
  "name": "medipro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "run-p dev:react dev:electron",
    "dev:react": "vite",
    "dev:electron": "npm run transpile:electron && cross-env NODE_ENV=development electron .",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:push": "drizzle-kit push",
    "db:clear": "tsx scripts/clear-db.ts",
    "db:wipe-client": "tsx scripts/wipe-client-data.ts",
    "transpile:electron": "tsc --project src/electron/tsconfig.json",
    "dist:win": "npm run build:all && electron-builder --win --x64",
    "dist:mac": "npm run build:all && electron-builder --mac",
    "dist:linux": "npm run build:all && electron-builder --linux",
    "build:all": "npm run transpile:electron && npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "cd backend && npm run build && npm run bundle:esbuild && (robocopy ../dist-react dist-react /E /Y || xcopy /E /I /Y ..\\dist-react dist-react)"
  },
