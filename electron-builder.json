{
  "appId": "com.akram.doc-right",
  "productName": "DocRight",
  "asar": true,
  "compression": "maximum",
  "files": [
    "dist-electron/**",
    "dist-react/**",
    "!**/*.map",
    "!**/*.md",
    "!**/test/**",
    "!**/__tests__/**"
  ],
  "extraResources": [
    {
      "from": "public/meds.json",
      "to": "meds.json"
    },
    {
      "from": "public/common_bilans.json",
      "to": "common_bilans.json"
    },
    {
      "from": "public/common_consultations.json",
      "to": "common_consultations.json"
    },
    {
      "from": "public/fonts",
      "to": "public/fonts"
    },
    {
      "from": "public/public.pem",
      "to": "public.pem"
    },
    {
      "from": "database.db",
      "to": "database.db"
    }
  ],
  "icon": "./icon.png",
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": "AppImage",
    "category": "Utility"
  },
  "win": {
    "target": [
      "portable",
      "msi"
    ]
  }
}