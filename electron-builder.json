{
  "appId": "com.akram.doc-right",
  "files": ["dist-electron", "dist-react"],
  "extraResources": [
    {
      "from": "public/meds.json",
      "to": "meds.json"
    },
    {
      "from": "database.db",
      "to": "database.db"
    },
    {
      "from": "public/fonts",
      "to": "public/fonts"
    }
  ],
  "icon": "./icon.png",
  "mac": { "target": "dmg" },
  "linux": { "target": "AppImage", "category": "Utility" },
  "win": { "target": ["portable", "msi"] }
}
