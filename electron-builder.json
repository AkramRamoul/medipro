{
  "appId": "com.akram.medipro",
  "productName": "MediPro",
  "asar": true,
  "compression": "maximum",
  "files": [
    "dist-electron/**",
    "dist-react/**",
    "backend/**",
    "backend/node_modules/**",
    "node_modules/**",
    "package.json",
    "!**/*.map",
    "!**/*.md",
    "!**/test/**",
    "!**/__tests__/**"
  ],
  "asarUnpack": [
    "backend/**",
    "node_modules/@libsql/**",
    "node_modules/libsql/**",
    "node_modules/@neon-rs/**",
    "node_modules/detect-libc/**"
  ],
  "extraResources": [
    {
      "from": "public/meds.json",
      "to": "meds.json"
    },
    {
      "from": "public/common_bilans.json",
      "to": "common_bilans.json"
    },
    {
      "from": "public/common_consultations.json",
      "to": "common_consultations.json"
    },
    {
      "from": "public/fonts",
      "to": "public/fonts"
    },
    {
      "from": "public/public.pem",
      "to": "public.pem"
    },
    {
      "from": "database.db",
      "to": "database.db"
    }
  ],
  "icon": "./icon.png",
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": "AppImage",
    "category": "Utility"
  },
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "certificateFile": "build/medipro.pfx",
    "certificatePassword": "medipro"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "include": "build/installer.nsh"
  }
}