{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "bin": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "bundle": "node scripts/bundle.js",
    "bundle:esbuild": "esbuild src/server.ts --bundle --platform=node --target=node20 --external:libsql --external:@neon-rs/* --external:detect-libc --outfile=server-bundle.js"
  },
  "pkg": {
    "assets": [
      "dist/**/*",
      "../dist-react/**/*",
      "uploads/**/*",
      "node_modules/drizzle-orm/**/*"
    ],
    "scripts": [
      "dist/**/*.js",
      "node_modules/drizzle-orm/**/*.js",
      "node_modules/drizzle-orm/**/*.cjs"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}