{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "bin": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "bundle": "node scripts/bundle.js",
    "bundle:esbuild": "esbuild src/server.ts --bundle --platform=node --target=node20 --external:libsql --external:@neon-rs/* --external:detect-libc --outfile=server-bundle.js"
  },
  "pkg": {
    "assets": [
      "dist/**/*",
      "../dist-react/**/*",
      "uploads/**/*",
      "node_modules/drizzle-orm/**/*"
    ],
    "scripts": [
      "dist/**/*.js",
      "node_modules/drizzle-orm/**/*.js",
      "node_modules/drizzle-orm/**/*.cjs"
    ]
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/exceljs": "^1.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}
